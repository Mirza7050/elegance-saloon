# ELEGANCE SALOON — SERVER CONFIGURATION & SECRETS

# Server Port
PORT=5000

# Salon Verified Contact Information (Phone format without + or spaces for WhatsApp API)
SALON_PHONE=+919876543210
ADMIN_PIN=1234

# -------------------------------------------------------------
# META WHATSAPP BUSINESS PLATFORM CLOUD API CREDENTIALS
# Obtain these from: https://developers.facebook.com/apps
# -------------------------------------------------------------

# 1. Custom Webhook Verify Token (Set the exact same token in Meta App Dashboard > WhatsApp > Configuration > Webhook)
WHATSAPP_VERIFY_TOKEN=elegance_saloon_secure_token_2026

# 2. WhatsApp Business Account ID (Found in WhatsApp > API Setup)
WHATSAPP_ACCOUNT_ID=your_whatsapp_business_account_id_here

# 3. WhatsApp Phone Number ID (Found in WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# 4. Meta System User Permanent Access Token (Generate in Meta Business Settings > System Users with 'whatsapp_business_messaging' permission)
WHATSAPP_ACCESS_TOKEN=EAAB...your_system_user_permanent_token_here

# -------------------------------------------------------------
# OPTIONAL AI MODEL CREDENTIALS (e.g., Google Gemini / OpenAI)
# -------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
